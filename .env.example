# Copy to .env and fill in values. Never commit .env.
# .env is gitignored.

# ---------- Unsplash (BACKEND ONLY) ----------
# Use these only on a server (e.g. when triggering downloads or fetching photo metadata).
# Never put Unsplash keys in the app bundle or client-side code.
# UNSPLASH_APPLICATION_ID=
# UNSPLASH_ACCESS_KEY=
# UNSPLASH_SECRET_KEY=

# ---------- AdMob (Expo / client) ----------
# EXPO_PUBLIC_ADS_ENV=production
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
# EXPO_PUBLIC_ADMOB_IOS_REWARDED_UNIT_ID=
# EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_UNIT_ID=
# EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=
# EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=
